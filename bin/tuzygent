#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Application\Service\TuzygentHarnessService;
use App\Infrastructure\Container\Container;

$root = dirname(__DIR__);
$autoload = $root . '/vendor/autoload.php';
if (is_file($autoload)) {
    require_once $autoload;
} else {
    spl_autoload_register(static function (string $class) use ($root): void {
        $prefix = 'App\\';
        if (strncmp($prefix, $class, strlen($prefix)) === 0) {
            $file = $root . '/src/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
            if (is_file($file)) require_once $file;
        }
    });
}

$config = require $root . '/config/app.php';
$harness = (new Container($config))->get(TuzygentHarnessService::class);
$command = $argv[1] ?? '';

if ($command === 'verify') {
    $report = $harness->runVerificationGate();
    echo $report['summary'] . "\n";
    exit($report['passed'] ? 0 : 1);
}

if ($command === 'update:recover') {
    if ($harness->recoverInterruptedUpdate()) {
        echo "Đã khôi phục snapshot của lần cập nhật bị gián đoạn và mở lại website.\n";
        exit(0);
    }
    fwrite(STDERR, "Không thể khôi phục an toàn. Website vẫn giữ chế độ bảo trì; kiểm tra snapshot và database trước khi mở lại.\n");
    exit(1);
}

if ($command === 'continuous') {
    $interval = 5;
    $autoDiscover = false;
    foreach (array_slice($argv, 2) as $argument) {
        if (str_starts_with($argument, '--interval=')) {
            $interval = max(1, min(300, (int) substr($argument, strlen('--interval='))));
        } elseif ($argument === '--auto-discover') {
            $autoDiscover = true;
        }
    }
    $harness->runContinuousLoop(0, $interval, $autoDiscover);
    exit(0);
}

if ($command === 'continuous:worker') {
    $token = (string) ($argv[2] ?? '');
    $tokenFile = $root . '/.harness/continuous_worker.token';
    $storedToken = is_file($tokenFile) ? trim((string) file_get_contents($tokenFile)) : '';
    if ($token === '' || $storedToken === '' || !hash_equals($storedToken, $token)) {
        fwrite(STDERR, "Worker chỉ được khởi chạy bởi Dashboard Harness.\n");
        exit(2);
    }
    unlink($tokenFile);
    $state = $harness->getContinuousState();
    $harness->runContinuousLoop(
        (int) ($state['max_cycles'] ?? 0),
        (int) ($state['interval_seconds'] ?? 5),
        (bool) ($state['auto_discover'] ?? true)
    );
    exit(0);
}

if ($command === 'task:worker') {
    $token = (string) ($argv[2] ?? '');
    if (preg_match('/^[a-f0-9]{64}$/', $token) !== 1) {
        fwrite(STDERR, "Worker task chỉ được khởi chạy bởi Dashboard Harness.\n");
        exit(2);
    }
    $tokenFile = $root . '/.harness/task_worker_tokens/' . $token;
    $storedToken = is_file($tokenFile) ? trim((string) file_get_contents($tokenFile)) : '';
    if ($storedToken === '' || !hash_equals($storedToken, $token) || !unlink($tokenFile)) {
        fwrite(STDERR, "Worker task chỉ được khởi chạy bởi Dashboard Harness.\n");
        exit(2);
    }
    $harness->runQueuedTasksWorker();
    exit(0);
}

fwrite(STDERR, "Harness được điều khiển qua Dashboard tại /admin/harness.\n");
exit(2);
